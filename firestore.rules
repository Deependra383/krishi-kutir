rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile access: user can read/write their own document
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Products: readable by everyone, writeable by admin or public in app
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders: readable & writeable for order placement and status updates
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Store settings: readable by all, writeable by admin
    match /store_settings/{settingId} {
      allow read, write: if true;
    }
    
    // Partner inquiries (B2B partnerships): readable & writeable
    match /partner_inquiries/{inquiryId} {
      allow read, write: if true;
    }
    
    // Training inquiries (Academy contact): readable & writeable
    match /training_inquiries/{inquiryId} {
      allow read, write: if true;
    }
  }
}
