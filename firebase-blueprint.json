{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string", "required": true },
        "email": { "type": "string", "required": false },
        "displayName": { "type": "string", "required": false },
        "phone": { "type": "string", "required": false },
        "address": { "type": "string", "required": false },
        "city": { "type": "string", "required": false },
        "state": { "type": "string", "required": false },
        "pincode": { "type": "string", "required": false },
        "role": { "type": "string", "required": false, "enum": ["user", "admin"] },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "Product": {
      "collection": "products",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "price": { "type": "number", "required": true },
        "unit": { "type": "string", "required": false },
        "moq": { "type": "string", "required": false },
        "category": { "type": "string", "required": true },
        "benefit": { "type": "string", "required": false },
        "image": { "type": "string", "required": false },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "Order": {
      "collection": "orders",
      "fields": {
        "id": { "type": "string", "required": true },
        "userId": { "type": "string", "required": false },
        "userEmail": { "type": "string", "required": false },
        "customerName": { "type": "string", "required": true },
        "phone": { "type": "string", "required": true },
        "address": { "type": "string", "required": true },
        "city": { "type": "string", "required": true },
        "state": { "type": "string", "required": true },
        "pincode": { "type": "string", "required": true },
        "items": { "type": "array", "required": true },
        "subtotal": { "type": "number", "required": true },
        "deliveryFee": { "type": "number", "required": true },
        "totalAmount": { "type": "number", "required": true },
        "paymentMethod": { "type": "string", "required": true },
        "paymentId": { "type": "string", "required": false },
        "status": { "type": "string", "required": true, "enum": ["Pending Verification", "Confirmed", "Processing", "Dispatched", "Delivered", "Cancelled", "Placed"] },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "StoreSettings": {
      "collection": "store_settings",
      "fields": {
        "razorpayKeyId": { "type": "string", "required": false },
        "updatedAt": { "type": "timestamp", "required": false }
      }
    },
    "PartnerInquiry": {
      "collection": "partner_inquiries",
      "fields": {
        "fullName": { "type": "string", "required": true },
        "businessName": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "phone": { "type": "string", "required": true },
        "partnerType": { "type": "string", "required": true },
        "cityLocation": { "type": "string", "required": true },
        "estimatedVolume": { "type": "string", "required": false },
        "message": { "type": "string", "required": false },
        "status": { "type": "string", "required": false, "enum": ["New Partner Inquiry", "Contacted", "Proposal Sent", "Contracted", "Closed"] },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "TrainingInquiry": {
      "collection": "training_inquiries",
      "fields": {
        "fullName": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "phone": { "type": "string", "required": true },
        "experienceLevel": { "type": "string", "required": false },
        "trainingMode": { "type": "string", "required": false },
        "message": { "type": "string", "required": false },
        "status": { "type": "string", "required": false, "enum": ["New Inquiry", "Contacted", "Enrolled", "Closed"] },
        "createdAt": { "type": "timestamp", "required": false }
      }
    }
  }
}
